{
  "name": "dataroom-api",
  "version": "0.1.0",
  "private": true,
  "description": "Data Room API — NestJS + Prisma + PostgreSQL + S3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "prisma migrate deploy && node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "tsx prisma/migrate-all.ts",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force && pnpm db:seed",
    "db:seed": "prisma db seed",
    "db:verify": "tsx prisma/verify.ts",
    "db:studio": "prisma studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\"",
    "format": "prettier --write \"{src,test,prisma}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:int": "jest --config jest.int.config.js --runInBand",
    "openapi:emit": "nest build && node dist/tools/emit-openapi.js",
    "gc:orphans": "tsx scripts/gc-orphans.ts",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "nanoid": "^5.1.6",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.16.3",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.2.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.0",
    "jest": "^30.2.0",
    "pdf-lib": "^1.17.1",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.6.2",
    "prisma": "^7.9.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
