# Copy to .env (gitignored). The defaults below work against the local
# docker-compose stack as-is — nothing needs editing.

# --- Database ---
# Prisma 7 talks to Postgres through a driver adapter (@prisma/adapter-pg), so the
# pool size is a pg.Pool option in code, NOT a `connection_limit` URL parameter.
DATABASE_URL=postgresql://dataroom:dataroom@localhost:5433/dataroom
# Direct (unpooled) connection used for DDL. Identical locally; in production this is
# Neon's direct string, because migrations must not run over the pooler.
DIRECT_URL=postgresql://dataroom:dataroom@localhost:5433/dataroom
# Separate database for integration tests: they truncate between cases, which would
# destroy the dev seed if they shared a database.
TEST_DATABASE_URL=postgresql://dataroom:dataroom@localhost:5433/dataroom_test
DB_POOL_MAX=10

# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# --- Auth ---
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Window in which a just-rotated refresh token is still accepted. Without it, several
# tabs refreshing at once trip reuse detection and log the user out (see README).
REFRESH_ROTATION_GRACE_SECONDS=10

# --- Storage (MinIO locally, AWS S3 in production) ---
S3_BUCKET=dataroom-dev
S3_REGION=eu-west-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- Uploads ---
UPLOAD_MAX_BYTES=52428800
PRESIGN_PUT_TTL_SECONDS=900
PRESIGN_GET_TTL_SECONDS=300
