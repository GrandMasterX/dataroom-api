    "/nodes/{id}/children": {
      "get": {
        "description": "Keyset pagination: pass the previous page’s cursor. Ordered folders first, then by name, case-insensitively.",
        "operationId": "NodesController_children",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "Opaque cursor from the previous page",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 200,
              "default": 50,
              "type": "number"
            }
          },
          {
            "name": "type",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "FOLDER",
                "FILE"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChildrenPageDto"
                }
              }
            }
          }
        },
        "summary": "One page of a folder’s contents",
        "tags": [
          "nodes"
        ]
      }
    },
