  "info": {
    "title": "Data Room API",
    "description": "Secure document repository for due diligence.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "dana@acme.com"
          },
          "password": {
            "type": "string",
            "example": "Password123!",
            "minLength": 10
          },
          "displayName": {
            "type": "string",
            "example": "Dana Owner"
          }
        },
        "required": [
          "email",
          "password",
          "displayName"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "displayName"
        ]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDto"
          },
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string",
            "description": "Store server-side; the browser never sees this directly."
          },
          "accessTokenExpiresInSeconds": {
            "type": "number",
            "description": "Seconds until the access token expires."
          }
        },
        "required": [
          "user",
          "accessToken",
          "refreshToken",
          "accessTokenExpiresInSeconds"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "dana@acme.com"
          },
          "password": {
            "type": "string",
            "example": "Password123!"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Opaque refresh token issued by login or a previous refresh"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "NodeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
