        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PresignedItemDto"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "CompleteUploadDto": {
        "type": "object",
        "properties": {
          "intentId": {
            "type": "string"
