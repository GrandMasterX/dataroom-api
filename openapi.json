      "PresignItemDto": {
        "type": "object",
        "properties": {
          "fileName": {
            "type": "string",
            "example": "Q1 2026 Accounts.pdf"
          },
          "mimeType": {
            "type": "string",
            "example": "application/pdf"
          },
          "sizeBytes": {
            "type": "number",
