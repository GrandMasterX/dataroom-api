          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "inline",
              "attachment"
            ]
          },
          "fileName": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "number"
          }
        },
        "required": [
          "url",
          "expiresAt",
          "disposition",
          "fileName",
          "mimeType",
          "sizeBytes"
        ]
      },
