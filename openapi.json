          "onConflict": {
            "type": "string",
            "enum": [
              "fail",
              "rename",
              "newVersion"
            ],
            "default": "fail",
            "description": "\"newVersion\" adds a version to the colliding file instead of creating a second one."
          }
        },
        "required": [
          "intentId"
        ]
      },
      "UploadResultDto": {
        "type": "object",
        "properties": {
          "node": {
            "$ref": "#/components/schemas/NodeDto"
