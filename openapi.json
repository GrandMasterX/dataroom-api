      "PresignBatchDto": {
        "type": "object",
        "properties": {
          "parentId": {
            "type": "string"
          },
          "items": {
            "description": "Batched deliberately: one request per file would collide with this API’s own rate limit the first time someone drags in a folder.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PresignItemDto"
            }
          }
        },
        "required": [
          "parentId",
          "items"
        ]
      },
      "UploadConflictDto": {
        "type": "object",
        "properties": {
          "existingNodeId": {
            "type": "string"
          },
          "existingType": {
            "type": "string",
            "enum": [
              "FOLDER",
              "FILE"
            ],
            "description": "A collision with a folder cannot be resolved by adding a version — the UI needs this to avoid offering a dead option."
          },
          "versionCount": {
            "type": "number",
            "description": "Versions the existing file already has"
          }
        },
        "required": [
          "existingNodeId",
          "existingType",
          "versionCount"
        ]
      },
      "PresignedItemDto": {
        "type": "object",
        "properties": {
          "intentId": {
            "type": "string"
          },
          "uploadUrl": {
            "type": "string"
          },
          "contentType": {
            "type": "string",
            "description": "Send exactly this Content-Type or the signature will not match"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "conflict": {
            "description": "Advisory: reported before the bytes are sent so the user is asked first.",
            "allOf": [
              {
                "$ref": "#/components/schemas/UploadConflictDto"
              }
            ]
          }
        },
        "required": [
          "intentId",
          "uploadUrl",
          "contentType",
          "expiresAt"
        ]
      },
