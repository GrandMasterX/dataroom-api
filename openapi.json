                  "$ref": "#/components/schemas/PresignBatchResultDto"
                }
              }
            }
          }
        },
        "summary": "Get signed URLs for a batch of files",
        "tags": [
          "uploads"
        ]
      }
    },
    "/uploads/complete": {
      "post": {
        "description": "Idempotent: repeating a completed upload returns the same result. A conflict does not consume the upload, so the client can answer differently without sending the bytes again.",
        "operationId": "UploadsController_complete",
